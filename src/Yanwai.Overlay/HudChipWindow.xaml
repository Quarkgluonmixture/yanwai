<Window x:Class="Yanwai.Overlay.HudChipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Ideal">

  <Border Background="#E6232326" CornerRadius="6" Padding="8,0,10,0"
          BorderBrush="#33FFFFFF" BorderThickness="1" HorizontalAlignment="Left">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Ellipse x:Name="SeverityDot" Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center" />
      <TextBlock x:Name="ChipText" FontSize="12" Foreground="#E6E6EA"
                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    </StackPanel>
  </Border>
</Window>
