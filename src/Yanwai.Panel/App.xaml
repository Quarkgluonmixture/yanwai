<Application x:Class="Yanwai.Panel.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="PageBackground" Color="#F5F5F7" />
    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorder" Color="#E2E2E6" />
    <SolidColorBrush x:Key="PrimaryText" Color="#1A1A1C" />
    <SolidColorBrush x:Key="MutedText" Color="#7A7A80" />
    <SolidColorBrush x:Key="BarFill" Color="#D6D6DB" />
    <SolidColorBrush x:Key="BarFillTop" Color="#3F8F6B" />
  </Application.Resources>
</Application>
