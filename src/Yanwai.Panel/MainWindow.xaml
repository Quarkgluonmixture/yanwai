<Window x:Class="Yanwai.Panel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Yanwai.Panel"
        Title="Jev 会话解读面板"
        Width="980" Height="720"
        MinWidth="820" MinHeight="560"
        Background="{StaticResource PageBackground}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Ideal">

  <Window.Resources>
    <DataTemplate x:Key="RowTemplate" DataType="{x:Type local:JudgmentRow}">
      <Grid Margin="0,2,0,2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="128" />
          <ColumnDefinition Width="46" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                   Foreground="{StaticResource PrimaryText}" FontSize="12" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding ProbabilityText}" FontSize="12"
                   Foreground="{StaticResource MutedText}" HorizontalAlignment="Right"
                   VerticalAlignment="Center" Margin="0,0,8,0" />
        <Rectangle Grid.Column="2" Height="8" RadiusX="4" RadiusY="4"
                   HorizontalAlignment="Left" VerticalAlignment="Center"
                   Width="{Binding BarWidth}">
          <Rectangle.Style>
            <!-- Fill lives only in the style: a local Fill on the element would
                 outrank the trigger and the highlight would never show. -->
            <Style TargetType="Rectangle">
              <Setter Property="Fill" Value="{StaticResource BarFill}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Highlight}" Value="True">
                  <Setter Property="Fill" Value="{StaticResource BarFillTop}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Rectangle.Style>
        </Rectangle>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="CardTemplate" DataType="{x:Type local:JudgmentCard}">
      <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}"
              BorderThickness="1" CornerRadius="8" Padding="14,12,14,12" Margin="0,0,0,10">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryText}" />
            <TextBlock Text="{Binding Summary}" FontSize="12" Margin="10,1,0,0"
                       Foreground="{StaticResource MutedText}"
                       Visibility="{Binding HasSummary, Converter={x:Static local:BoolToVisibility.Instance}}" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowTemplate}" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="400" />
      <ColumnDefinition Width="14" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <DockPanel Grid.Column="0">
      <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" FontSize="12"
                 Foreground="{StaticResource MutedText}" TextWrapping="Wrap"
                 Text="每行一句，前面加「对方:」或「我:」。分析的是对方发来的最后一条。" />

      <Border DockPanel.Dock="Bottom" Margin="0,10,0,0">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="AnalyzeButton" Content="分析 (Ctrl+Enter)" Padding="14,6"
                    Click="OnAnalyzeClick" />
            <Button x:Name="SampleButton" Content="放一段示例" Padding="14,6" Margin="8,0,0,0"
                    Click="OnSampleClick" />
            <ToggleButton x:Name="LiveToggle" Content="实时模式" Padding="14,6" Margin="8,0,0,0"
                          Checked="OnLiveChecked" Unchecked="OnLiveUnchecked" />
            <Button x:Name="JudgeLatestButton" Content="判定最后一条" Padding="14,6" Margin="8,0,0,0"
                    IsEnabled="False" Click="OnJudgeLatestClick"
                    ToolTip="对屏幕上对方最后一条消息做判定，不用等新消息" />
          </StackPanel>
          <TextBlock x:Name="StatusText" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                     Foreground="{StaticResource MutedText}" />
        </StackPanel>
      </Border>

      <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}"
              BorderThickness="1" CornerRadius="8" Padding="4">
        <TextBox x:Name="ConversationBox" AcceptsReturn="True" TextWrapping="Wrap"
                 BorderThickness="0" Background="Transparent" FontSize="13"
                 VerticalScrollBarVisibility="Auto" Padding="8" />
      </Border>
    </DockPanel>

    <DockPanel Grid.Column="2">
      <Border DockPanel.Dock="Top" Background="{StaticResource CardBackground}"
              BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8"
              Padding="14,10,14,10" Margin="0,0,0,10">
        <StackPanel>
          <TextBlock Text="正在判断的消息" FontSize="11" Foreground="{StaticResource MutedText}" />
          <TextBlock x:Name="TargetText" Margin="0,4,0,0" FontSize="14" TextWrapping="Wrap"
                     Foreground="{StaticResource PrimaryText}" Text="—" />
          <Grid x:Name="HeadlineRow" Margin="0,10,0,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="危险等级" FontSize="11" Foreground="{StaticResource MutedText}" />
              <TextBlock x:Name="DangerText" Margin="0,2,0,0" FontSize="14" FontWeight="SemiBold"
                         TextWrapping="Wrap" Foreground="{StaticResource PrimaryText}" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="建议" FontSize="11" Foreground="{StaticResource MutedText}" />
              <TextBlock x:Name="AdviceText" Margin="0,2,0,0" FontSize="14" FontWeight="SemiBold"
                         TextWrapping="Wrap" Foreground="{StaticResource BarFillTop}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="CardList" ItemTemplate="{StaticResource CardTemplate}" />
      </ScrollViewer>
    </DockPanel>
  </Grid>
</Window>
